{
  "name": "kaluz-digital",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma digital para la operación de transporte y turismo de Kaluz.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
